<Project>
	<!-- Shared by every project: the game's assemblies are referenced in place (never copied, never committed). -->
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>9</LangVersion>
		<Nullable>disable</Nullable>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<Deterministic>true</Deterministic>
		<!-- Override on the command line: dotnet build -p:GameDir="D:\SteamLibrary\steamapps\common\CarX Drift Racing Online" -->
		<GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\CarX Drift Racing Online</GameDir>
		<ManagedDir>$(GameDir)\Drift Racing Online_Data\Managed</ManagedDir>
		<BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx\core</BepInExDir>
		<RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
		<OutputPath>$(RepoRoot)build\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
	</ItemGroup>
</Project>
